# 复制为 .env 后填入实际值；.env 已被 .gitignore 忽略，不会提交。
# CI 部署时该文件由 Gitea Actions 依据仓库 Secrets 自动生成。

# AI PC 宿主机上 agent 的地址（<AI_PC_IP> 替换为实际内网 IP）
AGENT_URL=http://<AI_PC_IP>:9101

# 与 agent 共享的令牌（两端一致）
AGENT_TOKEN=change-me

# 版本号（可选）：格式 major.minor.build；CI 部署时自动写入
# （major.minor 来自 VERSION 文件，build = 总 commit 数，每次 push 自动 +1）；
# 手动部署可填 $(cut -d. -f1,2 VERSION).$(git rev-list --count HEAD)，留空显示 dev
HWMON_VERSION=
