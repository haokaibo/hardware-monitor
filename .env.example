# Copy to .env and fill in real values. .env is gitignored and never committed.
# On CI deploys this file is generated from repository secrets.
#
# This file lists every variable the code reads. All are optional except
# AGENT_TOKEN when the agent is reachable from more than one host.

# --- required for the web client -------------------------------------------

# Address of the agent on the monitored host (replace <HOST_IP> with its LAN IP)
AGENT_URL=http://<HOST_IP>:9101

# shared token; must match on agent and web
AGENT_TOKEN=change-me

# --- optional: both roles ---------------------------------------------------

# Listen port. Default: agent 9101, web 8080.
# PORT=8080

# Version shown at the bottom right of the page, format major.minor.build.
# CI writes it automatically (major.minor from the VERSION file, build = total
# commits). For manual deploys: $(cut -d. -f1,2 VERSION).$(git rev-list --count HEAD).
# Empty shows "dev", or the installed package version when running from a wheel.
HWMON_VERSION=

# --- optional: agent only ---------------------------------------------------

# Label in the dashboard header. Defaults to the machine's hostname.
# AGENT_LABEL=my-host

# Override the GPU display name. sysfs rarely exposes a model string, so the
# agent falls back to "AMD GPU (cardN)".
# GPU_NAME=AMD Radeon RX 7900 XTX

# Set to 1 to also list the CPU iGPU. It is hidden by default because it
# reports a small, misleading VRAM figure (< 2 GB).
# INCLUDE_IGPU=1

# --- test/debug only --------------------------------------------------------

# Redirect every /proc and /sys read into a fake tree. Used by the test suite
# and by `python -m hwmon.collectors --root`. Leave unset in production.
# HWMON_ROOT=/path/to/fake/root
