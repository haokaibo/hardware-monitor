# 复制为 .env 后填入实际值；.env 已被 .gitignore 忽略，不会提交。
# CI 部署时该文件由 Gitea Actions 依据仓库 Secrets 自动生成。

# AI PC 宿主机上 agent 的地址（<AI_PC_IP> 替换为实际内网 IP）
AGENT_URL=http://<AI_PC_IP>:9101

# 与 agent 共享的令牌（两端一致）
AGENT_TOKEN=change-me

# 版本号（可选）：CI 部署时自动写入 commit 短 SHA（每次 push 一个新版本）；
# 手动部署可填 commit 短 SHA（git rev-parse --short=7 HEAD），留空显示 dev
HWMON_VERSION=
