# Linux test environment for hwmon.
#
# Why: the collectors read /proc and /sys, and the interesting branches
# (AMD GPU via drm, NVMe/SATA hwmon, LVM folding) only exist on Linux. This
# image lets you run the full suite and the collector CLI against a real kernel
# instead of the fake tree, on any host.
#
#   docker build -f dev/Dockerfile.test -t hwmon-test .
#   docker run --rm hwmon-test                      # full suite
#   docker run --rm hwmon-test uv run python -m hwmon.collectors
#   docker run --rm --privileged --pid=host hwmon-test \
#     uv run python -m hwmon.collectors               # real host sensors
FROM python:3.12-slim

# gcc is needed by the Cython build test; without it that test silently skips
# and the Linux leg stops covering the compiled pro tier.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/* \
 && curl -LsSf https://astral.sh/uv/install.sh | sh \
 && install -m 0755 "$(command -v uv || echo "$HOME/.local/bin/uv")" /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/hwmon/venv \
    PATH=/opt/hwmon/venv/bin:$PATH

WORKDIR /src
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-install-project --all-extras
COPY src ./src
COPY tests ./tests
COPY licensing ./licensing
COPY packaging ./packaging
COPY docs ./docs
# The packaging tests read these from the repo root; a test image that omits
# them turns a missing COPY into a test failure that looks like a code bug.
COPY docker-compose.yml Dockerfile ./ 
# Every root-level document the tests read. Kept as an explicit list rather than
# a wildcard so the image cannot silently gain files, but it has to be updated
# when a document is added - a missing entry fails as FileNotFoundError inside a
# test, which looks like a code bug. tests/test_packaging.py guards it.
COPY VERSION LICENSE ./
COPY README.md README.zh-CN.md AGENT.md SECURITY.md BUILD-COMPARISON.md ./
RUN uv sync --frozen --all-extras
# make sources world-readable for any non-root user
RUN chmod -R a+rX /src

# The fake-host tests do not need privileges; only real-sensor runs do.
CMD ["uv", "run", "pytest", "-q"]
